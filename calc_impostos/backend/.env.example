PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ret_impostos
DB_USER=postgres
DB_PASSWORD=postgres

# ── Integração com o Rauf SaaS (somente API; chaves geradas pelo admin do órgão no Rauf) ──
RAUF_API_URL=https://rauf-app-backend.onrender.com
# Vários órgãos:  UASG:chave,UASG:chave      |  Um único órgão: RAUF_API_KEY
RAUF_API_KEYS=
RAUF_API_KEY=
# UASG usada enquanto não houver login por órgão (dados legados = HUCAM)
CALC_UASG_PADRAO=155012

# ── Cadastro da chave do Rauf pela tela "Integração Rauf" (temporário até o login por usuário) ──
# Token que o administrador digita na tela e segredo usado para cifrar as chaves no banco (>= 16 caracteres)
CALC_ADMIN_TOKEN=
CALC_SECRET_KEY=
